# Konfigurasi AI Provider untuk Chicken-Agent

# 1. Pilihan Anthropic Claude (Direkomendasikan jika punya Claude API Key)
ANTHROPIC_API_KEY=isi_api_key_kamu_di_sini
CHICKEN_MODEL=claude-3-5-sonnet-20241022

# 2. Pilihan Alternatif: Google Gemini API (Bisa didapat gratis di https://aistudio.google.com/)
# GEMINI_API_KEY=isi_gemini_api_key_kamu_di_sini

# 3. Pilihan Alternatif: OpenAI / Groq / Local Router (seperti bansos-router di port 17070)
# OPENAI_API_KEY=isi_openai_atau_groq_key_di_sini
# OPENAI_BASE_URL=http://127.0.0.1:17070/v1

# Pengaturan Token
CHICKEN_MAX_TOKENS=4096
