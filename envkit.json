{
  "name": "chicken-agent",
  "type": "custom",
  "dev_server": {
    "enabled": true,
    "port": 5050
  },
  "tasks": {
    "web": {
      "command": "python main.py --web",
      "description": "Jalankan Chicken-Agent Web UI (Port 5050)"
    },
    "cli": {
      "command": "python main.py",
      "description": "Jalankan Chicken-Agent Terminal CLI"
    },
    "dsh": {
      "command": "npx @deepseek-ai/dsh web",
      "description": "Jalankan DeepSeek Harness Web UI (Port 3080)"
    },
    "both": {
      "command": "cmd /c start_all.bat",
      "description": "Jalankan Keduanya (Chicken-Agent + DeepSeek Harness)"
    }
  }
}
